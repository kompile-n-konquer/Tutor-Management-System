generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id             Int         @id @default(autoincrement())
  studentNumber  String?
  employeeNumber String?
  firstName      String
  lastName       String
  email          String      @unique
  phoneNumber    String?
  yearOfStudy    String?     // one of: 3rd year, honours, masters, phd
  role           String      @default("STUDENT") // intentionally String: SQL Server doesn't support Prisma enums; one of STUDENT/TUTOR/LECTURER/ORGANISER/ADMIN, validated in application code
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  firebaseUid    String      @unique
  applications   Application[]
  courses        Course[]
  availability   Availability[]
  assignments    TutorAssignment[]
  busyBlocks     BusyBlock[]
  timesheets     Timesheet[]
  roleApplications RoleApplication[]
  supervisedTimesheets TimesheetEntry[] @relation("TimesheetSupervisor")
  overflowClaims OverflowWork[]
  swapRequestsSent     SwapRequest[] @relation("SwapRequestsSent")
  swapRequestsReceived SwapRequest[] @relation("SwapRequestsReceived")
  volunteerRequests SessionVolunteer[]
  timetablePdf      TimetablePdf?
  eventAttendance EventRegister[]
}

// Join table between User (role TUTOR) and Course — one row records that a user
// with the tutor role tutors a course in a given semester. Hours are derived from
// the course's slots, so only the semester is stored here.
model TutorAssignment {
  id        Int       @id @default(autoincrement())
  userId    Int
  courseId  Int
  semester  String
  sessions  Session[]
  user      User      @relation(fields: [userId], references: [id])
  course    Course    @relation(fields: [courseId], references: [id], onUpdate: NoAction)
}

model Application {
  id             Int       @id @default(autoincrement())
  userId         Int
  courseId       Int
  courseMark     Float
  transcriptPath String?
  status         String    @default("PENDING")
  appliedAt        DateTime  @default(now())
  reviewedAt       DateTime?
  course           Course             @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  user             User               @relation(fields: [userId], references: [id])
}

model Course {
  id               Int               @id @default(autoincrement())
  courseCode       String            @unique
  courseName       String
  minimumMark      Float
  tutorsRequired   Int               @default(1) // number of tutors needed for this course
  acceptingApplications Boolean     @default(false) // opened for tutor applications; managed via the bulk start-application-process action
  createdAt        DateTime          @default(now())
  userId           Int
  applications     Application[]
  user             User              @relation(fields: [userId], references: [id])
  slots            CourseSlot[]
  overflowWork     OverflowWork[]
  timesheetEntries TimesheetEntry[]
  assignments      TutorAssignment[]
  events           Event[]
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model TimeSlot {
  id           Int            @id @default(autoincrement())
  startMinute  Int
  endMinute    Int
  availability Availability[]
  courseSlots  CourseSlot[]

  @@unique([startMinute, endMinute])
}

// A user's uploaded PDF timetable (e.g. their class timetable). The file lives
// on disk in backend/uploads/ like the claim-form template; this row keeps the
// metadata and the availability extracted from the PDF so the upload persists
// across devices. One row per user — a new upload replaces the old file.
model TimetablePdf {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  filename       String
  originalName   String
  sizeBytes      Int
  extractedSlots String   @default("[]") @db.NVarChar(Max) // JSON [{ dayOfWeek, timeSlotId }] — SQL Server has no Prisma Json type
  cellContents   String?  @db.NVarChar(Max) // JSON of the raw per-cell text, kept so extraction can be re-calibrated without re-uploading
  uploadedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model Availability {
  id         Int      @id @default(autoincrement())
  userId     Int
  dayOfWeek  Int
  timeSlotId Int
  user       User     @relation(fields: [userId], references: [id])
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id])

  @@unique([userId, dayOfWeek, timeSlotId])
}

// Per-user busy time ranges (Issue 32) for users with the tutor role. Free-form minute-of-day
// values rather than a TimeSlot FK so tutors can block arbitrary unavailable ranges.
model BusyBlock {
  id          Int   @id @default(autoincrement())
  userId      Int
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  user        User  @relation(fields: [userId], references: [id])

  @@unique([userId, dayOfWeek, startMinute, endMinute])
}

model Timesheet {
  id              Int               @id @default(autoincrement())
  userId          Int
  name            String
  payrollNumber   String?
  totalHours      Int               @default(0)  
  status          String            @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  submittedAt     DateTime?
  approvedAt      DateTime?
  user            User              @relation(fields: [userId], references: [id])
  entries         TimesheetEntry[]
}

model TimesheetEntry {
  id           Int       @id @default(autoincrement())
  timesheetId  Int
  courseId     Int
  supervisorId Int
  eventId      Int?      @unique // the claimed event this entry was auto-created from; unique = an event can only be claimed once
  workDate     DateTime
  duration     Float     // 1–8 hours, whole numbers via the round-up rule (each timeslot counts as at least one full hour)
  description  String    // tutoring | marking | invigilation | admin
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  course       Course    @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  timesheet    Timesheet @relation(fields: [timesheetId], references: [id])
  supervisor   User      @relation("TimesheetSupervisor", fields: [supervisorId], references: [id], onUpdate: NoAction)
  event        Event?    @relation(fields: [eventId], references: [id], onUpdate: NoAction)
}

model Session {
  id               Int              @id @default(autoincrement())
  assignmentId     Int
  date             DateTime
  courseSlotId     Int
  status           String           @default("SCHEDULED") // SCHEDULED | UNASSIGNED | PENDING
  excuseReason     String?
  assignment       TutorAssignment  @relation(fields: [assignmentId], references: [id])
  courseSlot       CourseSlot       @relation(fields: [courseSlotId], references: [id], onUpdate: NoAction)
  volunteerRequest SessionVolunteer?
}
model SessionVolunteer {
  id        Int      @id @default(autoincrement())
  sessionId Int      @unique
  userId    Int
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model CourseSlot {
  id          Int      @id @default(autoincrement())
  courseId    Int
  dayOfWeek   Int
  timeSlotId  Int
  venue       String?
  sessionType String?
  course      Course   @relation(fields: [courseId], references: [id])
  timeSlot    TimeSlot @relation(fields: [timeSlotId], references: [id])
  sessions    Session[]

  @@index([courseId, dayOfWeek])
}

// Calendar event a lecturer schedules for one of their courses on a specific date.
// The time is never stored — it is derived from the course's tutoring timeslots on
// that date's weekday, so it stays correct when the lecturer edits the course slots.
model Event {
  id          Int      @id @default(autoincrement())
  courseId    Int
  date        DateTime // stored at UTC midnight; its weekday drives the timeslot lookup
  description String   // tutoring | marking | invigilation | admin (same options as timesheet entries)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  claims      TimesheetEntry[]
  register    EventRegister[]
  givenSwaps    SwapRequest[] @relation("SwapRequestGivenEvent")
  receivedSwaps SwapRequest[] @relation("SwapRequestReceivedEvent")

  @@index([courseId, date])
}

// Attendance register for an event: one row per tutor the owning lecturer
// marked present on the day. Timesheet approval reads this table — an entry
// claiming an event the tutor was not marked present for cannot be approved,
// and the lecturer is pointed at rejection instead.
model EventRegister {
  id       Int      @id @default(autoincrement())
  eventId  Int
  userId   Int
  markedAt DateTime @default(now())
  event    Event    @relation(fields: [eventId], references: [id], onUpdate: NoAction)
  user     User     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@unique([eventId, userId])
}

// A tutor-to-tutor request to trade an assigned session (a claimed event).
// The requester offers one of their claimed sessions to the recipient; a
// recipient session may be attached for a two-way trade. The recipient
// accepts or declines first, then the organiser approves or rejects — the
// same approval authority as a tutor being allocated. Status flow:
//   PENDING → ACCEPTED → APPROVED
//     ↓ recipient declines      ↓ organiser rejects
//   REJECTED                    REJECTED
// (the requester may CANCEL while the request is still PENDING)
model SwapRequest {
  id               Int       @id @default(autoincrement())
  requesterId      Int
  recipientId      Int
  requesterEventId Int
  recipientEventId Int?      // set for a two-way trade; null = a one-way handover
  status           String    @default("PENDING") // PENDING | ACCEPTED | APPROVED | REJECTED | CANCELLED
  reason           String?
  requestedAt      DateTime  @default(now())
  respondedAt      DateTime? // recipient's accept/decline timestamp
  reviewedAt       DateTime? // organiser's approve/reject timestamp
  reviewedById     Int?      // organiser's User.id; no FK to avoid cascade paths
  rejectionReason  String?

  // NoAction on both user FKs: the two paths into User would otherwise form a
  // cascade cycle on SQL Server, and a kept swap request must survive user tidy-up.
  requester        User      @relation("SwapRequestsSent", fields: [requesterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipient        User      @relation("SwapRequestsReceived", fields: [recipientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requesterEvent   Event     @relation("SwapRequestGivenEvent", fields: [requesterEventId], references: [id], onUpdate: NoAction)
  recipientEvent   Event?    @relation("SwapRequestReceivedEvent", fields: [recipientEventId], references: [id], onUpdate: NoAction)

  @@index([requesterId, status])
  @@index([recipientId, status])
  @@index([status])
}

model OverflowWork {
  id          Int    @id @default(autoincrement())
  courseId    Int
  description String
  hours       Int
  postedBy    Int
  claimedBy   Int?
  status      String
  user        User?  @relation(fields: [claimedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course      Course @relation(fields: [courseId], references: [id], onUpdate: NoAction)
}

/// Tracks a student's application to become a Tutor or Lecturer.
/// The organiser reviews each application and either approves (changing the
/// user's role and creating the Tutor/Lecturer record) or rejects it.
model RoleApplication {
  id              Int       @id @default(autoincrement())
  userId          Int
  requestedRole   String    // TUTOR or LECTURER
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedById    Int?      // organiser's User.id; no FK to avoid cascade paths

  // ── Tutor-specific fields (populated when requestedRole = TUTOR) ──
  hourlyRate      Float?
  maxHoursPerWeek Int?

  // ── Lecturer-specific fields (populated when requestedRole = LECTURER) ──
  department      String?
  officeLocation  String?
  officeHours     String?

  rejectionReason String?

  user            User      @relation(fields: [userId], references: [id])

  @@unique([userId, requestedRole, status])
}

/// Audit log for outgoing notification emails (assignment added/removed,
/// timesheet approved/rejected). One row per send attempt; the dedupeKey
/// makes duplicate sends of the same event impossible.
model EmailLog {
  id              Int       @id @default(autoincrement())
  eventType       String // ASSIGNMENT_ADDED | ASSIGNMENT_REMOVED | TIMESHEET_APPROVED | TIMESHEET_REJECTED | TIMESHEET_STUCK_REMINDER
  entityType      String // Prisma model name of the affected entity, e.g. TutorAssignment / Timesheet
  entityId        Int
  dedupeKey       String
  recipientEmail  String
  recipientUserId Int? // User.id of the recipient when known
  status          String    @default("PENDING") // PENDING while in flight, then SENT or FAILED
  subject         String?
  attemptedAt     DateTime  @default(now())
  sentAt          DateTime?
  errorMessage    String? // failure details when status = FAILED

  @@index([dedupeKey, status])
}
