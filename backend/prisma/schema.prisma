generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id               Int              @id @default(autoincrement())
  studentNumber    String?
  employeeNumber   String?
  firstName        String
  lastName         String
  email            String           @unique
  phoneNumber      String?
  role             String           @default("STUDENT") // intentionally String: SQL Server doesn't support Prisma enums; one of STUDENT/TUTOR/LECTURER/ORGANISER/ADMIN, validated in application code
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  firebaseUid      String           @unique
  applications     Applicant[]
  roleApplications RoleApplication[]
  lecturer         Lecturer?
  tutor            Tutor?
  availability     Availability[]
}

model Tutor {
  id               Int               @id @default(autoincrement())
  userId           Int               @unique
  hourlyRate       Float?
  maxHoursPerWeek  Int // weekly hour cap; hours remaining is derived as cap - sum of assigned session durations for the week (Issue 32)
  status           String
  approvedAt       DateTime?
  busyBlocks       BusyBlock[]
  overflowClaims   OverflowWork[]
  timesheets       Timesheet[]
  user             User              @relation(fields: [userId], references: [id])
  assignments      TutorAssignment[]
  courseTutorMarks CourseTutorMark[]
}

model Lecturer {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  department     String
  officeLocation String?
  officeHours    String?
  courses        Course[]
  user           User     @relation(fields: [userId], references: [id])
}

model Applicant {
  id             Int       @id @default(autoincrement())
  userId         Int
  courseId       Int
  courseMark     Float
  transcriptPath String?
  availability   String?
  status         String    @default("PENDING")
  appliedAt        DateTime  @default(now())
  reviewedAt       DateTime?
  course           Course             @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  user             User               @relation(fields: [userId], references: [id])
  tutorAssignment  TutorAssignment?
}

model Course {
  id               Int               @id @default(autoincrement())
  courseCode       String            @unique
  courseName       String
  minimumMark      Float
  requiredTutors   Int               @default(1)
  budgetHours      Float             @default(0)
  hourlyRate       Float             @default(0)
  lecturerId       Int
  applications     Applicant[]
  lecturer         Lecturer          @relation(fields: [lecturerId], references: [id])
  slots            CourseSlot[]
  overflowWork     OverflowWork[]
  timesheetEntries TimesheetEntry[]
  assignments      TutorAssignment[]
  courseTutorMarks CourseTutorMark[]
}

model CourseTutorMark {
  id       Int    @id @default(autoincrement())
  tutorId  Int
  courseId Int
  mark     Float
  tutor    Tutor  @relation(fields: [tutorId], references: [id])
  course   Course @relation(fields: [courseId], references: [id], onUpdate: NoAction)

  @@unique([tutorId, courseId])
}

model TutorAssignment {
  id             Int        @id @default(autoincrement())
  tutorId        Int?
  courseId       Int
  applicantId    Int?       @unique
  allocatedHours Int
  semester       String
  status         String
  sessions       Session[]
  course         Course     @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  tutor          Tutor?     @relation(fields: [tutorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  applicant      Applicant? @relation(fields: [applicantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model TimeSlot {
  id           Int            @id @default(autoincrement())
  startMinute  Int
  endMinute    Int
  availability Availability[]
  courseSlots  CourseSlot[]

  @@unique([startMinute, endMinute])
}

model Availability {
  id         Int      @id @default(autoincrement())
  userId     Int
  dayOfWeek  Int
  timeSlotId Int
  user       User     @relation(fields: [userId], references: [id])
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id])

  @@unique([userId, dayOfWeek, timeSlotId])
}

// Per-tutor busy time ranges (Issue 32). Free-form minute-of-day values rather than a
// TimeSlot FK so tutors can block arbitrary unavailable ranges; a tutor may have many blocks.
model BusyBlock {
  id          Int   @id @default(autoincrement())
  tutorId     Int
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  tutor       Tutor @relation(fields: [tutorId], references: [id])

  @@unique([tutorId, dayOfWeek, startMinute, endMinute])
}

model Timesheet {
  id            Int              @id @default(autoincrement())
  tutorId       Int
  payrollNumber String?
  totalHours    Float
  totalAmount   Float?
  status        String           @default("DRAFT")
  submittedAt   DateTime?
  approvedAt    DateTime?
  tutor         Tutor            @relation(fields: [tutorId], references: [id])
  entries       TimesheetEntry[]
}

model TimesheetEntry {
  id          Int       @id @default(autoincrement())
  timesheetId Int
  courseId    Int
  workDate    DateTime
  startTime   DateTime
  endTime     DateTime
  duration    Float
  taskType    String
  description String
  supervisor  String
  isApproved  Boolean   @default(false)
  course      Course    @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id])
}

model Session {
  id            Int             @id @default(autoincrement())
  assignmentId  Int
  date          DateTime
  courseSlotId  Int
  status        String          @default("SCHEDULED")
  excuseReason  String?
  assignment    TutorAssignment @relation(fields: [assignmentId], references: [id])
  courseSlot    CourseSlot      @relation(fields: [courseSlotId], references: [id], onUpdate: NoAction)
}

model CourseSlot {
  id          Int      @id @default(autoincrement())
  courseId    Int
  dayOfWeek   Int
  timeSlotId  Int
  venue       String?
  sessionType String?
  course      Course   @relation(fields: [courseId], references: [id])
  timeSlot    TimeSlot @relation(fields: [timeSlotId], references: [id])
  sessions    Session[]

  @@index([courseId, dayOfWeek])
}

model OverflowWork {
  id          Int    @id @default(autoincrement())
  courseId    Int
  description String
  hours       Int
  postedBy    Int
  claimedBy   Int?
  status      String
  tutor       Tutor? @relation(fields: [claimedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course      Course @relation(fields: [courseId], references: [id], onUpdate: NoAction)
}

/// Tracks a student's application to become a Tutor or Lecturer.
/// The organiser reviews each application and either approves (changing the
/// user's role and creating the Tutor/Lecturer record) or rejects it.
model RoleApplication {
  id              Int       @id @default(autoincrement())
  userId          Int
  requestedRole   String    // TUTOR or LECTURER
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedById    Int?      // organiser's User.id; no FK to avoid cascade paths

  // ── Tutor-specific fields (populated when requestedRole = TUTOR) ──
  hourlyRate      Float?
  maxHoursPerWeek Int?

  // ── Lecturer-specific fields (populated when requestedRole = LECTURER) ──
  department      String?
  officeLocation  String?
  officeHours     String?

  rejectionReason String?

  user            User      @relation(fields: [userId], references: [id])

  @@unique([userId, requestedRole, status])
}

/// Audit log for outgoing notification emails (assignment added/removed,
/// timesheet approved/rejected). One row per send attempt; the dedupeKey
/// makes duplicate sends of the same event impossible.
model EmailLog {
  id              Int       @id @default(autoincrement())
  eventType       String // ASSIGNMENT_ADDED | ASSIGNMENT_REMOVED | TIMESHEET_APPROVED | TIMESHEET_REJECTED | TIMESHEET_STUCK_REMINDER
  entityType      String // Prisma model name of the affected entity, e.g. TutorAssignment / Timesheet
  entityId        Int
  dedupeKey       String
  recipientEmail  String
  recipientUserId Int? // User.id of the recipient when known
  status          String    @default("PENDING") // PENDING while in flight, then SENT or FAILED
  subject         String?
  attemptedAt     DateTime  @default(now())
  sentAt          DateTime?
  errorMessage    String? // failure details when status = FAILED

  @@index([dedupeKey, status])
}
