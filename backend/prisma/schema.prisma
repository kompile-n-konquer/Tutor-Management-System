generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id             Int         @id @default(autoincrement())
  studentNumber  String?
  employeeNumber String?
  firstName      String
  lastName       String
  email          String      @unique
  phoneNumber    String?
  role           String      @default("STUDENT") // intentionally String: SQL Server doesn't support Prisma enums; one of STUDENT/TUTOR/LECTURER/ORGANISER/ADMIN, validated in application code
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  firebaseUid    String      @unique
  applications   Applicant[]
  lecturer       Lecturer?
  tutor          Tutor?
}

model Tutor {
  id               Int               @id @default(autoincrement())
  userId           Int               @unique
  hourlyRate       Float?
  maxHoursPerWeek  Int
  availableHours   Int
  currentHours     Int               @default(0) // stored, kept in sync by assign/excuse logic — see note below
  status           String
  approvedAt       DateTime?
  availability     Availability[]
  overflowClaims   OverflowWork[]
  timesheets       Timesheet[]
  user             User              @relation(fields: [userId], references: [id])
  assignments      TutorAssignment[]
  courseTutorMarks CourseTutorMark[]
}

model Lecturer {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  department     String
  officeLocation String?
  officeHours    String?
  courses        Course[]
  user           User     @relation(fields: [userId], references: [id])
}

model Applicant {
  id             Int       @id @default(autoincrement())
  userId         Int
  courseId       Int
  courseMark     Float
  transcriptPath String?
  availability   String?
  status         String    @default("PENDING")
  appliedAt      DateTime  @default(now())
  reviewedAt     DateTime?
  course         Course    @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  user           User      @relation(fields: [userId], references: [id])
}

model Course {
  id               Int               @id @default(autoincrement())
  courseCode       String            @unique
  courseName       String
  minimumMark      Float
  budget           Float? // course tutoring budget, used by the spend-vs-budget report (Issue 11)
  lecturerId       Int
  applications     Applicant[]
  lecturer         Lecturer          @relation(fields: [lecturerId], references: [id])
  slots            CourseSlot[]
  overflowWork     OverflowWork[]
  timesheetEntries TimesheetEntry[]
  assignments      TutorAssignment[]
  courseTutorMarks CourseTutorMark[]
}

model CourseTutorMark {
  id       Int    @id @default(autoincrement())
  tutorId  Int
  courseId Int
  mark     Float
  tutor    Tutor  @relation(fields: [tutorId], references: [id])
  course   Course @relation(fields: [courseId], references: [id], onUpdate: NoAction)

  @@unique([tutorId, courseId])
}

model TutorAssignment {
  id             Int       @id @default(autoincrement())
  tutorId        Int
  courseId       Int
  allocatedHours Int
  semester       String
  status         String
  sessions       Session[]
  course         Course    @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  tutor          Tutor     @relation(fields: [tutorId], references: [id])
}

model TimeSlot {
  id           Int            @id @default(autoincrement())
  startMinute  Int
  endMinute    Int
  availability Availability[]
  courseSlots  CourseSlot[]

  @@unique([startMinute, endMinute])
}

model Availability {
  id         Int      @id @default(autoincrement())
  tutorId    Int
  dayOfWeek  Int
  timeSlotId Int
  tutor      Tutor    @relation(fields: [tutorId], references: [id])
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id])

  @@unique([tutorId, dayOfWeek, timeSlotId])
}

model Timesheet {
  id            Int              @id @default(autoincrement())
  tutorId       Int
  payrollNumber String?
  totalHours    Float
  totalAmount   Float?
  status        String           @default("DRAFT")
  submittedAt   DateTime?
  approvedAt    DateTime?
  tutor         Tutor            @relation(fields: [tutorId], references: [id])
  entries       TimesheetEntry[]
}

model TimesheetEntry {
  id          Int       @id @default(autoincrement())
  timesheetId Int
  courseId    Int
  workDate    DateTime
  startTime   DateTime
  endTime     DateTime
  duration    Float
  taskType    String
  description String
  supervisor  String
  isApproved  Boolean   @default(false)
  course      Course    @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id])
}

model Session {
  id            Int             @id @default(autoincrement())
  assignmentId  Int
  date          DateTime
  courseSlotId  Int
  status        String          @default("SCHEDULED")
  excuseReason  String?
  assignment    TutorAssignment @relation(fields: [assignmentId], references: [id])
  courseSlot    CourseSlot      @relation(fields: [courseSlotId], references: [id], onUpdate: NoAction)
}

model CourseSlot {
  id          Int      @id @default(autoincrement())
  courseId    Int
  dayOfWeek   Int
  timeSlotId  Int
  venue       String?
  sessionType String?
  course      Course   @relation(fields: [courseId], references: [id])
  timeSlot    TimeSlot @relation(fields: [timeSlotId], references: [id])
  sessions    Session[]

  @@index([courseId, dayOfWeek])
}

model OverflowWork {
  id          Int    @id @default(autoincrement())
  courseId    Int
  description String
  hours       Int
  postedBy    Int
  claimedBy   Int?
  status      String
  tutor       Tutor? @relation(fields: [claimedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course      Course @relation(fields: [courseId], references: [id], onUpdate: NoAction)
}
